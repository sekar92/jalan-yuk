# Application Configuration
APP_NAME="Jalan Yuk!"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
# Options for DB_CONNECTION: mysql or sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jalan_yuk
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback path (used when DB_CONNECTION=sqlite or auto-fallback is enabled)
SQLITE_PATH=database/jalan_yuk.sqlite
AUTO_FALLBACK_SQLITE=true
